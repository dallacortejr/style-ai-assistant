# Variáveis do copiloto (usadas por academic/). Copie para academic/.env — nunca versionar.
# Provedor do LLM: ollama (local, sem custo) ou gemini
LLM_PROVIDER=ollama
# Chave Google Gemini (apenas se LLM_PROVIDER=gemini). GOOGLE_API_KEY também é aceita.
GEMINI_API_KEY=
# Servidor e modelo Ollama local
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
# A casca web TanStack (src/) não requer variáveis.
